# Supabase (Project Settings → API Keys; legacy anon/service_role keys retire in early 2027, so use the new keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Runtime: transaction pooler, port 6543 (prepare: false — ADR-005)
DATABASE_URL=
# Migrations and the db:check / db:audit scripts: session pooler (port 5432) or direct connection.
# db:seed does NOT use this — it goes through the app's own data layer, so it reads DATABASE_URL.
DATABASE_DIRECT_URL=

# Sign-in (PF-013, ADR-021). Supabase sign-in turns on when the Supabase URL and publishable key are set;
# AUTH_DRIVER=demo keeps demo mode (one local user, no sign-in — never in production).
AUTH_DRIVER=
# Base URL that sign-in links return to; add <APP_URL>/auth/callback to Supabase → Authentication → URL Configuration
APP_URL=http://localhost:3000
# Extra sign-in buttons besides email links: github (enable the GitHub provider in Supabase first)
AUTH_OAUTH_PROVIDERS=

# AI (server-only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=
# AI budget (ADR-035): runs one user may start per minute; tokens (in + out) a workspace may use per calendar month (UTC)
AI_RUNS_PER_USER_PER_MINUTE=12
AI_MONTHLY_TOKEN_BUDGET_PER_WORKSPACE=2000000
# HTTP rate limits (PF-084): requests per minute per user or API key, by route class
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_EXPORT_PER_MIN=20
RATE_LIMIT_GENERATE_PER_MIN=12
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=240

# Evals
RUN_LIVE_LLM_TESTS=false
# Most tokens (in + out) one `pnpm eval` run may use with a real model before it stops (ADR-010); default 1000000
EVAL_TOKEN_CAP=

# Data (ADR-011, ADR-022): file = .data/productforge.json, memory = in-process (demo mode, no Supabase needed);
# postgres = every module's data in Supabase as the signed-in user (needs Supabase sign-in); the file store is
# then refused outright, so nothing can fall back to it (ADR-031)
# Production sets DATA_DRIVER=postgres (see docs/DEPLOY.md).
DATA_DRIVER=file
# DATA_FILE=.data/productforge.json
LOG_LEVEL=info

# AI provider (ADR-011): demo engine unless OPENAI_API_KEY is set. AI_PROVIDER=demo forces the demo engine.
# OPENAI_MODEL defaults to gpt-5-mini when empty.
AI_PROVIDER=
